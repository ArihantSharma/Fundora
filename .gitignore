docker-compose.override.yml

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# ── OS / IDE clutter ─────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db
