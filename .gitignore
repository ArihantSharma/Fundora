# ── Node / Frontend ──────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/dist-ssr/

# ── Python / Backend ─────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo

# ── Database ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Environment secrets ───────────────────────────────────────────
.env
.env.local
.env.*.local

