# Fundora — environment variable reference
# Copy relevant sections to the appropriate .env files.
# Never commit real private keys or secrets.

# ── frontend/.env ────────────────────────────────────────────────────────────
# Set automatically by Docker at container start (docker-entrypoint.sh).
# For local dev (npm run dev), run the deploy script first and paste the address.

VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_API_URL=http://localhost:8000

# ── backend (set in docker-compose.yml environment section) ──────────────────
DATABASE_URL=sqlite:////app/data/fundora.db

# Auth: secret key for session tokens. Change this in production.
SECRET_KEY=dev-secret-change-me

# CORS: the origin the browser uses to reach the frontend.
FRONTEND_ORIGIN=http://localhost:5173

# Set to true to seed demo data on first run (useful for development).
SEED_ON_STARTUP=false

# ── blockchain (set in docker-compose.yml environment section) ───────────────
# RPC URL used by the deploy container to reach the Hardhat node.
HARDHAT_RPC_URL=http://hardhat:8545
# Directory where deployment.json is written.
SHARED_DIR=/shared
# Hardhat account #0 private key. This is the well-known public test key
# used by every Hardhat project. It has no real monetary value.
# The backend uses it to sign the onlyOwner registerStartup() call.
DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
